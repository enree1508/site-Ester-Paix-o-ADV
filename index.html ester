.prazo .wrap{position:relative;display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(32px,6vw,88px);align-items:start}
.prazo-txt{display:flex;flex-direction:column;gap:22px}
.prazo-txt p{color:var(--creme-2)}
.prazo-txt .lei{font-size:14px;border-left:1px solid var(--ouro-rose);padding-left:16px;color:var(--creme-2)}
.calc{background:var(--vinho-3);border:1px solid var(--linha-forte);padding:clamp(24px,3.5vw,44px);display:flex;flex-direction:column;gap:26px;box-shadow:0 40px 80px -40px rgba(0,0,0,.6)}
.calc label{display:block;font-size:12px;letter-spacing:.26em;text-transform:uppercase;color:var(--creme-2);margin-bottom:10px}
.calc input[type=date]{width:100%;font:400 22px var(--serif);color:var(--creme);background:transparent;border:0;border-bottom:1px solid var(--linha-forte);padding:8px 0 12px;color-scheme:dark;border-radius:0}
.calc input[type=date]:focus{outline:none;border-bottom-color:var(--ouro-claro)}
.calc .nota{font-size:13px;color:var(--creme-2);opacity:.85}
.linha-tempo{position:relative;height:66px;margin-top:6px}
.linha-tempo .base{position:absolute;left:0;right:0;top:30px;height:1px;background:var(--linha-forte)}
.linha-tempo .gasto{position:absolute;left:0;top:29px;height:3px;background:var(--ouro);transition:width .8s cubic-bezier(.2,.7,.2,1)}
.linha-tempo .marco{position:absolute;top:0;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--creme-2);transform:translateX(-50%);white-space:nowrap}
.linha-tempo .marco::after{content:"";position:absolute;left:50%;top:24px;width:9px;height:9px;margin-left:-5px;border:1px solid var(--ouro-rose);background:var(--vinho-3);transform:rotate(45deg)}
.linha-tempo .marco.ini{left:0;transform:none}.linha-tempo .marco.ini::after{left:4px}
.linha-tempo .marco.fim{left:auto;right:0;transform:none;text-align:right}.linha-tempo .marco.fim::after{left:auto;right:0}
.linha-tempo .hoje{position:absolute;top:44px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ouro-claro);transform:translateX(-50%);white-space:nowrap;transition:left .8s cubic-bezier(.2,.7,.2,1)}
.resultado{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--linha)}
.resultado div{background:var(--vinho-3);padding:18px 18px 18px 0}
.resultado div:nth-child(2n){padding-left:18px}
.resultado dt{font-size:11.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--creme-2);margin-bottom:6px}
.resultado dd{margin:0;font-family:var(--serif);font-size:clamp(22px,2.4vw,30px);line-height:1.15;font-variant-numeric:tabular-nums lining-nums}
.estado{display:inline-flex;align-items:center;gap:10px;font-size:12.5px;letter-spacing:.2em;text-transform:uppercase;padding:9px 14px;border:1px solid var(--linha-forte);align-self:flex-start}
.estado i{width:8px;height:8px;border-radius:50%;background:#e9c46a;box-shadow:0 0 0 4px rgba(233,196,106,.18)}
.estado.ok i{background:#9fd3a8;box-shadow:0 0 0 4px rgba(159,211,168,.16)}
.estado.urgente i{background:#ffb27a;box-shadow:0 0 0 4px rgba(255,178,122,.2)}
.estado.fim i{background:#e58a8a;box-shadow:0 0 0 4px rgba(229,138,138,.2)}
.calc .aviso{font-size:13px;color:var(--creme-2);border-top:1px solid var(--linha);padding-top:18px}
@media (max-width:900px){.prazo .wrap{grid-template-columns:1fr}}
@media (max-width:460px){.resultado{grid-template-columns:1fr}.resultado div,.resultado div:nth-child(2n){padding:14px 0}}

/* sobre */
.sobre{background:#f1e4d3;color:var(--couro)}
.sobre::before{content:"";position:absolute;inset:0;background:radial-gradient(70% 90% at 80% 40%,rgba(255,250,236,.7),transparent 65%);pointer-events:none}
.sobre .wrap{position:relative}
.sobre .eyebrow{color:var(--bronze)}
.sobre h2{color:var(--couro)}
.sobre .gold{background:linear-gradient(170deg,#b9825f 0%,#933e41 60%,#6e2a2d 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.sobre-txt > p{color:#5a3a33!important}
.sobre-txt .destaque{color:var(--vinho)!important}
.sobre .pilares{border-top-color:rgba(119,70,55,.3)}
.sobre .pilares h3{color:var(--vinho)}
.sobre .pilares p{color:#6b4b43}
.sobre .retrato{order:2}
.sobre .retrato::before{border-color:rgba(147,62,65,.45)}
.sobre .retrato figcaption{color:var(--bronze)}
.sobre .retrato .quadro{box-shadow:0 50px 90px -45px rgba(63,24,27,.6),0 0 0 1px rgba(147,62,65,.3)}
.sobre .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(40px,7vw,110px);align-items:center}
.selo{position:relative;aspect-ratio:1;max-width:420px;width:100%;justify-self:center;perspective:900px}
.selo .disco{position:absolute;inset:0;border-radius:50%;border:1px solid var(--linha);display:grid;place-items:center;transform-style:preserve-3d;animation:balanco 9s ease-in-out infinite}
.selo .disco::before{content:"";position:absolute;inset:14px;border-radius:50%;border:1px dashed rgba(238,176,143,.22)}
.selo svg{width:68%;height:auto;transform:translateZ(40px);filter:drop-shadow(0 20px 22px rgba(30,6,8,.45))}
@keyframes balanco{0%,100%{transform:rotateY(-16deg) rotateX(6deg)}50%{transform:rotateY(16deg) rotateX(-4deg)}}
.sobre-txt{display:flex;flex-direction:column;gap:24px}
.sobre-txt > p{color:var(--creme-2);max-width:36em}
.sobre-txt .destaque{font-family:var(--serif);font-style:italic;font-size:clamp(22px,2.2vw,28px);line-height:1.35;color:var(--creme)}
.pilares{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-top:14px;padding-top:28px;border-top:1px solid var(--linha)}
.pilares h3{font-size:21px;margin-bottom:8px}
.pilares p{font-size:15px;color:var(--creme-2)}
/* retrato da advogada */
.sobre{overflow:hidden}
.retrato{position:relative;margin:0;width:100%;max-width:440px;justify-self:center;perspective:1200px}
.retrato::before{content:"";position:absolute;inset:18px -18px -18px 18px;border:1px solid var(--linha-forte);border-radius:50% 50% 0 0/30% 30% 0 0;pointer-events:none}
.retrato .quadro{position:relative;aspect-ratio:18/25;border-radius:50% 50% 0 0/30% 30% 0 0;overflow:hidden;background:#1d0b0c;box-shadow:0 50px 90px -40px rgba(20,4,6,.85),0 0 0 1px rgba(238,176,143,.35);transform-style:preserve-3d;transition:transform .6s cubic-bezier(.2,.7,.2,1);will-change:transform}
.retrato .quadro::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(63,24,27,.55),transparent 32%),radial-gradient(120% 80% at 50% 30%,transparent 55%,rgba(30,8,10,.35));pointer-events:none}
.retrato img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 38%;transform:scale(1.02);transition:transform 1.4s cubic-bezier(.2,.7,.2,1)}
.retrato:hover img{transform:scale(1.05)}
.medalha{position:absolute;left:-30px;bottom:44px;width:118px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 30%,#8a3a3e,var(--vinho-3) 70%);border:1px solid var(--linha-forte);display:grid;place-items:center;box-shadow:0 24px 40px -18px rgba(20,4,6,.8);animation:flutua 7s ease-in-out infinite;z-index:2}
.medalha::before{content:"";position:absolute;inset:7px;border-radius:50%;border:1px dashed rgba(238,176,143,.3)}
.medalha svg{width:46%;height:auto;filter:drop-shadow(0 6px 8px rgba(30,6,8,.5))}
@keyframes flutua{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-8px) rotate(4deg)}}
.retrato figcaption{position:absolute;right:-18px;bottom:-18px;transform:translateY(calc(100% + 14px));font-size:11.5px;letter-spacing:.28em;text-transform:uppercase;color:var(--creme-2);text-align:right}
@media (max-width:900px){.sobre .wrap{grid-template-columns:1fr}.sobre .retrato{order:0}.retrato{max-width:340px;margin-bottom:34px}.medalha{width:92px;left:-12px;bottom:30px}}
@media (max-width:640px){.pilares{grid-template-columns:1fr;gap:20px}}

/* etapas */
.etapas{background:var(--vinho-2)}
/* páginas */
.pagina.anim,.contato.anim{animation:entra .75s cubic-bezier(.2,.7,.2,1)}
@keyframes entra{from{opacity:0;transform:perspective(1600px) rotateX(3deg) translateY(26px)}to{opacity:1;transform:none}}
.troca{position:fixed;left:0;top:env(safe-area-inset-top,0px);height:2px;width:0;background:var(--ouro);z-index:80;pointer-events:none;opacity:0}
.troca.vai{animation:troca .7s cubic-bezier(.2,.7,.2,1)}
@keyframes troca{0%{width:0;opacity:1}70%{width:100%;opacity:1}100%{width:100%;opacity:0}}
body[data-pag="contato"] .contato{min-height:calc(100vh - 78px);display:flex;align-items:center}
body[data-pag="contato"] .contato .wrap{width:100%}
/* apresentação da advogada na página inicial */
.apres{background:var(--vinho-2);overflow:hidden}
.apres .wrap{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(40px,7vw,110px);align-items:center}
.apres .foto{position:relative;margin:0;max-width:420px;width:100%;justify-self:center}
.apres .foto::before{content:"";position:absolute;inset:-16px 16px 16px -16px;border:1px solid var(--linha-forte);border-radius:50% 50% 0 0/30% 30% 0 0;pointer-events:none}
.apres .foto img{position:relative;display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:50% 30%;border-radius:50% 50% 0 0/30% 30% 0 0;box-shadow:0 50px 90px -40px rgba(20,4,6,.85),0 0 0 1px rgba(238,176,143,.35)}
.apres-txt{display:flex;flex-direction:column;gap:24px}
.apres-txt p{color:var(--creme-2);max-width:34em}
.apres-txt .destaque{font-family:var(--serif);font-style:italic;font-size:clamp(22px,2.2vw,28px);line-height:1.35;color:var(--creme)}
@media (max-width:900px){.apres .wrap{grid-template-columns:1fr}.apres .foto{max-width:320px}}
/* chamada das áreas na página inicial */
.teaser{background:var(--vinho)}
.teaser-grade{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;perspective:1400px}
.t-card{display:flex;flex-direction:column;gap:14px;padding:clamp(28px,3vw,40px);text-decoration:none;border:1px solid var(--linha);background:linear-gradient(160deg,rgba(255,240,220,.07),rgba(40,10,12,.12));transform-style:preserve-3d;transition:transform .5s cubic-bezier(.2,.7,.2,1),border-color .4s}
.t-card:hover{border-color:var(--linha-forte)}
.t-card .rotulo{font-size:11.5px;letter-spacing:.28em;text-transform:uppercase;color:var(--ouro-rose)}
.t-card p{font-size:15.5px;color:var(--creme-2);flex:1}
.t-card .ver{display:inline-flex;align-items:center;gap:12px;font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:var(--ouro-claro)}
.t-card .ver::after{content:"";width:28px;height:1px;background:var(--ouro-rose);transition:width .4s}
.t-card:hover .ver::after{width:48px}
@media (max-width:900px){.teaser-grade{grid-template-columns:1fr}}
.passos{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));counter-reset:p;border-top:1px solid var(--linha-forte)}
.passos li{counter-increment:p;padding:32px 28px 8px 0;display:flex;flex-direction:column;gap:12px;position:relative}
.passos li + li{padding-left:28px;border-left:1px solid var(--linha)}
.passos li::before{content:counter(p,upper-roman);font-family:var(--serif);font-style:italic;font-size:44px;line-height:1;background:var(--ouro);-webkit-background-clip:text;background-clip:text;color:transparent}
.passos p{font-size:15.5px;color:var(--creme-2)}
@media (max-width:900px){.passos{grid-template-columns:1fr 1fr}.passos li:nth-child(3){border-left:0;padding-left:0}.passos li:nth-child(n+3){border-top:1px solid var(--linha)}}
@media (max-width:560px){.passos{grid-template-columns:1fr}.passos li,.passos li + li{border-left:0;padding-left:0}.passos li + li{border-top:1px solid var(--linha)}}

/* documentos */
.docs{background:var(--vinho-2)}
.docs-grade{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;perspective:1400px}
.doc{border:1px solid var(--linha);padding:32px 28px;background:var(--vinho-3);display:flex;flex-direction:column;gap:18px;transform-style:preserve-3d;transition:transform .5s cubic-bezier(.2,.7,.2,1),border-color .4s}
.doc:hover{border-color:var(--linha-forte)}
.doc .rotulo{font-size:11.5px;letter-spacing:.28em;text-transform:uppercase;color:var(--ouro-rose)}
.doc ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.doc li{display:flex;gap:14px;padding-block:11px;border-bottom:1px solid var(--linha);font-size:15.5px}
.doc li:last-child{border-bottom:0}
.doc li::before{content:"";flex:none;width:14px;height:17px;margin-top:4px;border:1px solid var(--ouro-rose);border-radius:1px;background:linear-gradient(var(--ouro-rose),var(--ouro-rose)) 3px 5px/6px 1px no-repeat,linear-gradient(var(--ouro-rose),var(--ouro-rose)) 3px 9px/6px 1px no-repeat}
@media (max-width:900px){.docs-grade{grid-template-columns:1fr}}

/* dúvidas */
.faq{background:var(--vinho-2)}
.faq .wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(32px,6vw,96px)}
.faq-lado{display:flex;flex-direction:column;gap:22px;align-self:start;position:sticky;top:120px}
.faq-lado p{color:var(--creme-2)}
details{border-bottom:1px solid var(--linha)}
details:first-of-type{border-top:1px solid var(--linha-forte)}
summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:24px;padding-block:24px;font-family:var(--serif);font-size:clamp(19px,1.8vw,23px);line-height:1.3}
summary::-webkit-details-marker{display:none}
