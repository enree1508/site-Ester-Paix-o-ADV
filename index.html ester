.contato .wrap{position:relative;display:flex;flex-direction:column;gap:32px}
.contato h2{font-size:clamp(38px,6vw,80px);max-width:14ch}
.fone{display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px}
.fone .num{font-family:var(--serif);font-size:clamp(32px,5vw,62px);line-height:1;font-variant-numeric:lining-nums;user-select:all}
.copiar{background:transparent;border:1px solid var(--linha-forte);color:var(--creme-2);font:400 11.5px var(--sans);letter-spacing:.22em;text-transform:uppercase;padding:11px 16px;cursor:pointer;transition:color .3s,border-color .3s}
.copiar:hover{color:var(--ouro-claro);border-color:var(--ouro-claro)}
.email{display:flex;flex-wrap:wrap;align-items:center;gap:10px 22px;padding-top:26px;border-top:1px solid var(--linha)}
.email .rot{font-size:12px;letter-spacing:.26em;text-transform:uppercase;color:var(--ouro-rose)}
.email .end{font-family:var(--serif);font-size:clamp(18px,2.2vw,26px);overflow-wrap:anywhere;user-select:all}
.contato .info{display:flex;flex-wrap:wrap;gap:12px 40px;color:var(--creme-2);font-size:14px;letter-spacing:.14em;text-transform:uppercase}

/* rodapé */
footer{background:#2f1113;padding-block:48px 40px;border-top:1px solid var(--linha)}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:28px}
footer .marca{height:48px}
footer .direitos{flex-basis:100%;padding-top:22px;border-top:1px solid var(--linha);font-size:12px;letter-spacing:.2em;text-transform:uppercase;max-width:none}
footer p{font-size:13px;color:var(--creme-2);max-width:52em;line-height:1.6}

/* whatsapp flutuante */
.zap{position:fixed;right:max(18px,env(safe-area-inset-right,0px));bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:60;width:58px;height:58px;border-radius:50%;background:var(--ouro);display:grid;place-items:center;box-shadow:0 14px 30px -10px rgba(30,6,8,.7);transition:transform .35s}
.zap:hover{transform:scale(1.06)}
.zap svg{width:26px;height:26px;fill:var(--couro)}

/* trilha sonora */
.som{position:fixed;left:max(16px,env(safe-area-inset-left,0px));bottom:calc(22px + env(safe-area-inset-bottom,0px));z-index:60;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;padding:0;background:rgba(63,24,27,.72);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid var(--linha-forte);color:var(--ouro-claro);cursor:pointer;box-shadow:0 10px 24px -10px rgba(20,4,6,.7);transition:border-color .3s,transform .3s,opacity .3s;opacity:.85}
.som:hover{opacity:1;border-color:var(--ouro-claro);transform:scale(1.06)}
.som svg{width:14px;height:14px;fill:currentColor}
.som .i-pause{display:none}
.som.tocando .i-play{display:none}.som.tocando .i-pause{display:block}
.som::after{content:"";position:absolute;inset:-1px;border-radius:50%;border:1px solid var(--ouro-rose);opacity:0;pointer-events:none}
.som.tocando::after{animation:pulso 2.8s ease-out infinite}
@keyframes pulso{0%{transform:scale(1);opacity:.55}100%{transform:scale(1.7);opacity:0}}
/* entrada suave (começa visível; só desloca) */
.sobe{transform:translateY(18px);transition:transform 1s cubic-bezier(.2,.7,.2,1)}
.sobe.visto{transform:none}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  html{scroll-behavior:auto}
  .sobe{transform:none}
}
.sobre h2,.sobre h2 .gold{color:#933e41!important;background:none!important;-webkit-text-fill-color:#933e41}.sobre .medalha{display:none!important}.sobre .eyebrow{color:#933e41!important}</style>

