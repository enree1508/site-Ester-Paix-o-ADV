})();

/* entrada suave */
(function(){
  var els=document.querySelectorAll('.sobe');
  if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('visto')});return}
  var io=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visto');io.unobserve(e.target)}})},{rootMargin:'0px 0px -8% 0px'});
  els.forEach(function(e){io.observe(e)});
})();

/* inclinação 3D nos painéis */
(function(){
  if(matchMedia('(prefers-reduced-motion: reduce)').matches||matchMedia('(hover: none)').matches)return;
  document.querySelectorAll('[data-tilt]').forEach(function(el){
    el.addEventListener('pointermove',function(e){
      var r=el.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
      el.style.transform='rotateY('+(x*7)+'deg) rotateX('+(-y*7)+'deg) translateZ(0)';
    });
    el.addEventListener('pointerleave',function(){el.style.transform=''});
  });
})();



/* trilha ambiente original em clima de bossa jazz leve (piano elétrico, baixo, cordas e chocalho), gerada ao vivo pelo navegador, em loop */
(function(){
  var b=document.getElementById('som'),AC=window.AudioContext||window.webkitAudioContext;
  if(!AC){b.hidden=true;return}
  var pausadoPeloVisitante=false;try{pausadoPeloVisitante=sessionStorage.getItem('ep-musica')==='off'}catch(e){}
  var ctx,master,dry,rev,ruido,querTocar=false,timer=null,prox=0,n=0;
  var BATIDA=60/92, DUR=BATIDA*8, VOL=.18;
  // Fá maior, clima alegre e sofisticado: Fmaj9 · Bbmaj9 · Gm9 · C13
  var BAIXO=[41,46,43,36];
  var ACORDE=[[57,60,64,67],[57,60,62,65],[58,62,65,69],[58,62,64,69]];
  // melodia composta em duas frases que se alternam  [batida, nota, duração]
  var MEL=[
    [[0,72,1],[1,74,.5],[1.5,76,1.5],[3.5,79,1],[4.5,77,1],[5.5,76,2]],
    [[.5,74,1],[1.5,77,1],[2.5,81,2],[5,79,1],[6,77,1.5]],
    [[0,77,1],[1,76,.5],[1.5,74,1],[2.5,72,1],[3.5,70,2],[6,72,1.5]],
    [[0,69,1],[1,70,.5],[1.5,72,1],[2.5,74,1],[3.5,76,2.5],[6.5,79,1]],
    [[0,81,1.5],[1.5,79,.5],[2,77,1],[3,76,1],[4,72,2],[6.5,74,1]],
    [[0,77,1],[1,81,1],[2,84,2],[4.5,82,1],[5.5,81,2]],
    [[0,79,1],[1,77,1],[2,74,1.5],[3.5,77,1],[4.5,74,1],[5.5,70,2]],
    [[0,72,1],[1,76,1],[2,79,1],[3,81,2],[5.5,79,.5],[6,76,1.5]]
  ];
  var COMP=[0,1.5,3,4.5,6,7];          // levada de bossa do piano
  var LINHA=[[0,0,1.5],[1.5,7,.5],[2,7,2],[4,0,1.5],[5.5,7,.5],[6,7,2]]; // baixo: fundamental e quinta
  function hz(m){return 440*Math.pow(2,(m-69)/12)}
  function montar(){
    ctx=new AC();
    master=ctx.createGain();master.gain.value=0;
    var brilho=ctx.createBiquadFilter();brilho.type='highshelf';brilho.frequency.value=3500;brilho.gain.value=1.5;
    var comp=ctx.createDynamicsCompressor();comp.threshold.value=-26;comp.ratio.value=4;comp.knee.value=12;
    master.connect(brilho);brilho.connect(comp);comp.connect(ctx.destination);
    rev=ctx.createConvolver();var L=Math.floor(ctx.sampleRate*3.2),buf=ctx.createBuffer(2,L,ctx.sampleRate);
    for(var c=0;c<2;c++){var d=buf.getChannelData(c);for(var i=0;i<L;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/L,3)}
    rev.buffer=buf;var wet=ctx.createGain();wet.gain.value=.4;rev.connect(wet);wet.connect(master);
    dry=ctx.createGain();dry.gain.value=.7;dry.connect(master);
    var NL=Math.floor(ctx.sampleRate*.2);ruido=ctx.createBuffer(1,NL,ctx.sampleRate);var nd=ruido.getChannelData(0);for(var k=0;k<NL;k++)nd[k]=Math.random()*2-1;
  }
  function envia(no,r){no.connect(dry);var s=ctx.createGain();s.gain.value=r;no.connect(s);s.connect(rev)}
  function painel(no,pan){if(!ctx.createStereoPanner)return no;var p=ctx.createStereoPanner();p.pan.value=pan;no.connect(p);return p}
  // piano elétrico (síntese FM)
  function ep(m,t,dur,v,pan,brilhante){
    var car=ctx.createOscillator(),mod=ctx.createOscillator(),mg=ctx.createGain(),g=ctx.createGain();
    var f=hz(m);car.frequency.value=f;mod.frequency.value=f*(brilhante?2:1);
    mg.gain.setValueAtTime(f*(brilhante?1.1:1.3),t);mg.gain.exponentialRampToValueAtTime(f*.08,t+.6);
    mod.connect(mg);mg.connect(car.frequency);
    var fim=t+dur+1.2;
    g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(v,t+.005);g.gain.exponentialRampToValueAtTime(v*.4,t+.35);
    g.gain.setValueAtTime(v*.4,t+dur);g.gain.exponentialRampToValueAtTime(.0004,fim);
    car.connect(g);envia(painel(g,pan||0),.45);
    car.start(t);mod.start(t);car.stop(fim+.05);mod.stop(fim+.05);
  }
  function cordas(m,t){
    var f=ctx.createBiquadFilter();f.type='lowpass';f.Q.value=.4;f.frequency.value=1600;
    var g=ctx.createGain();g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(.012,t+2);g.gain.setValueAtTime(.012,t+DUR-.5);g.gain.linearRampToValueAtTime(0,t+DUR+2);
    [-6,6].forEach(function(dt){var o=ctx.createOscillator();o.type='sawtooth';o.frequency.value=hz(m);o.detune.value=dt;o.connect(f);o.start(t);o.stop(t+DUR+2.2)});
    f.connect(g);envia(g,.8);
  }
  function baixo(m,t,dur){
    var o=ctx.createOscillator(),g=ctx.createGain(),lp=ctx.createBiquadFilter();o.type='triangle';o.frequency.value=hz(m);lp.type='lowpass';lp.frequency.value=600;
    g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(.14,t+.02);g.gain.exponentialRampToValueAtTime(.05,t+dur*BATIDA);g.gain.linearRampToValueAtTime(0,t+dur*BATIDA+.12);
    o.connect(lp);lp.connect(g);g.connect(dry);o.start(t);o.stop(t+dur*BATIDA+.2);
  }
  function chocalho(t,v){
    var s=ctx.createBufferSource(),hp=ctx.createBiquadFilter(),g=ctx.createGain();s.buffer=ruido;hp.type='highpass';hp.frequency.value=7000;
    g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.0001,t+.07);
    s.connect(hp);hp.connect(g);envia(painel(g,.35),.2);s.start(t);s.stop(t+.1);
  }
  function compasso(t){
    var k=n%4,ac=ACORDE[k],r=BAIXO[k];
    LINHA.forEach(function(x){baixo(r+x[1],t+x[0]*BATIDA,x[2])});
    ac.forEach(function(m){cordas(m+12,t)});
    COMP.forEach(function(bt,q){ac.forEach(function(m,i){ep(m,t+bt*BATIDA+i*.012,BATIDA*.55,q%3===0?.03:.022,(i-1.5)*.3,false)})});
    for(var e=0;e<16;e++)chocalho(t+e*BATIDA/2,e%2?.006:.011);
    MEL[n%8].forEach(function(x){ep(x[1],t+x[0]*BATIDA,x[2]*BATIDA,.06,-.1,true)});
    n++;
  }
  function agenda(){while(prox<ctx.currentTime+DUR){compasso(prox);prox+=DUR}}
  function visual(tocando){b.classList.toggle('tocando',tocando);b.setAttribute('aria-pressed',tocando?'true':'false');b.setAttribute('aria-label',tocando?'Pausar música ambiente':'Tocar música ambiente')}
  function iniciarSom(){
    if(!ctx)montar();
    var p=ctx.resume();
    var ok=function(){if(ctx.state!=='running'||!querTocar)return;
      if(!timer){prox=Math.max(prox,ctx.currentTime+.15);agenda();timer=setInterval(agenda,800)}
      master.gain.cancelScheduledValues(ctx.currentTime);master.gain.setValueAtTime(master.gain.value,ctx.currentTime);master.gain.linearRampToValueAtTime(VOL,ctx.currentTime+4);
      visual(true);soltarGatilhos();
    };
    if(p&&p.then)p.then(ok,function(){});else ok();
    setTimeout(ok,60);
  }
  function tocar(){querTocar=true;iniciarSom()}
  function pausar(){
    querTocar=false;visual(false);if(!ctx)return;
    master.gain.cancelScheduledValues(ctx.currentTime);master.gain.setValueAtTime(master.gain.value,ctx.currentTime);master.gain.linearRampToValueAtTime(0,ctx.currentTime+1);
    setTimeout(function(){if(!querTocar){clearInterval(timer);timer=null;ctx.suspend()}},1200);
  }
  b.addEventListener('click',function(e){e.stopPropagation();
    if(b.classList.contains('tocando')){pausar();try{sessionStorage.setItem('ep-musica','off')}catch(er){}}
    else{tocar();try{sessionStorage.removeItem('ep-musica')}catch(er){}}});
  // toca sozinha ao entrar; se o navegador exigir um gesto, começa no primeiro toque, clique ou tecla em qualquer ponto
  var EV=['pointerdown','touchstart','touchend','mousedown','keydown','click'];
  function gatilho(){if(querTocar)iniciarSom()}
  function soltarGatilhos(){EV.forEach(function(ev){removeEventListener(ev,gatilho,true)})}
  if(!pausadoPeloVisitante){querTocar=true;EV.forEach(function(ev){addEventListener(ev,gatilho,true)});iniciarSom()}
  document.addEventListener('visibilitychange',function(){if(!ctx)return;if(document.hidden)ctx.suspend();else if(querTocar)ctx.resume()});
})();

