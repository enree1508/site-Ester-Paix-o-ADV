  }
  let visivel=true,rodando=false;
  function loop(t){if(!visivel){rodando=false;return}render(t);requestAnimationFrame(loop)}
  new IntersectionObserver(en=>{visivel=en[0].isIntersecting;if(visivel&&!reduz&&!rodando){rodando=true;requestAnimationFrame(loop)}}).observe(box);
  render(0);
  box.classList.add('pronto');
  if(!reduz){rodando=true;requestAnimationFrame(loop)}
}catch(err){ /* sem WebGL: o monograma em SVG permanece */ }
</script>

