const SVG=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="1447 1108 2100 2783"><g transform="scale(1,-1)"><path d="M 3201.8 3160.8 C 3102.0 3245.7 2972.7 3286.9 2806.3 3286.9 L 2577.1 3286.9 L 2577.1 3308.8 L 3190.2 3308.8 L 3268.1 3092.7 C 3248.2 3117.0 3226.2 3140.0 3201.8 3160.8 "/><path d="M 2592.7 1162.3 L 1862.2 1162.3 C 1921.3 1202.7 1960.4 1267.1 1960.4 1338.0 L 1960.4 3115.8 C 1958.9 3195.4 1918.0 3265.9 1856.8 3308.8 L 2313.6 3308.8 L 2313.6 3286.9 L 2091.3 3286.9 L 2091.3 2260.7 L 2736.7 2260.7 C 2794.3 2263.0 2844.9 2289.8 2878.8 2330.9 L 2878.8 2169.4 C 2843.9 2211.9 2791.3 2239.5 2732.7 2240.6 L 2732 2240.6 L 2091.3 2240.6 L 2091.3 1184.1 L 2763.2 1184.2 C 2833.3 1188.5 2894.4 1224.4 2933.0 1277.6 L 2933.0 1118.3 C 2848.2 1140.4 2707.0 1161.2 2592.7 1162.3 "/><path d="M 2372.9 1908.1 L 2373.1 1911.9 L 2373.1 2207.3 L 2504.5 2207.3 L 2504.5 1755.1 L 2908.1 1755.1 C 3049.4 1755.1 3167.3 1805.9 3248.9 1901.9 C 3326.3 1992.9 3369.4 2122.8 3373.6 2277.5 C 3375.6 2352.4 3366.9 2432.4 3351.5 2481.3 C 3339.7 2518.9 3305.1 2629.9 3205.8 2718.2 C 3205.8 2718.2 3120.3 2794.2 2983.1 2828.4 C 2883.9 2853.1 2718.9 2856.1 2504.5 2835.5 L 2504.5 2296.0 L 2373.1 2296.0 L 2373.1 2820.7 C 2256.9 2805.9 2129.3 2785.1 1992.3 2758.1 L 1992.3 2764.7 C 2126.6 2793.7 2254.0 2816.4 2373.1 2833.1 L 2373.1 3688.6 C 2371.5 3768.2 2330.6 3838.7 2269.4 3881.6 L 2608.0 3881.6 C 2546.8 3838.7 2506.0 3768.2 2504.5 3688.6 L 2504.5 3687.9 L 2504.5 2849.5 C 2875.3 2889.8 3148.1 2866.6 3266.4 2790.2 C 3395.2 2707.1 3460.7 2595.7 3460.7 2595.7 C 3509.9 2511.9 3536.3 2414.7 3536.3 2310.5 C 3536.3 1950.2 3305.7 1735.2 2919.5 1735.2 L 2272.1 1735.1 C 2327.4 1774.0 2365.6 1835.9 2372.9 1908.1 "/><path d="M 2134.9 1407.1 C 2044.7 1421.0 1956.2 1447.9 1874.6 1489.4 C 1833.9 1510.0 1794.5 1533.7 1757.6 1560.7 C 1720.8 1587.8 1686.2 1617.9 1654.4 1650.8 C 1590.8 1716.6 1538.5 1793.9 1505.0 1879.4 C 1471.3 1964.6 1456.6 2058.0 1466.7 2149.4 C 1468.8 2172.3 1473.1 2194.9 1477.7 2217.4 C 1483.1 2239.7 1488.9 2262.0 1496.6 2283.7 C 1511.2 2327.2 1530.8 2369.0 1553.9 2408.7 C 1565.3 2428.6 1578.0 2447.8 1591.1 2466.6 C 1604.6 2485.2 1618.5 2503.5 1633.5 2520.9 C 1663.3 2555.8 1695.9 2588.4 1731.0 2617.9 C 1801.3 2677.0 1880.9 2725.0 1965.7 2760.2 L 1970.5 2748.6 C 1886.6 2714.4 1807.8 2667.5 1738.1 2609.5 C 1703.2 2580.5 1670.9 2548.5 1641.2 2514.2 C 1626.3 2497.2 1612.5 2479.2 1599.1 2460.9 C 1586.0 2442.4 1573.3 2423.6 1562.0 2403.9 C 1539.0 2364.9 1519.4 2323.7 1504.7 2280.9 C 1497.0 2259.5 1491.2 2237.6 1485.8 2215.6 C 1481.1 2193.4 1476.7 2171.2 1474.5 2148.6 C 1464.1 2058.5 1478.0 1966.2 1510.8 1881.7 C 1543.5 1796.9 1595.0 1719.8 1657.8 1654.1 C 1689.2 1621.2 1723.5 1591.1 1760.0 1563.9 C 1796.5 1536.7 1835.6 1513.0 1876.1 1492.2 C 1957.0 1450.4 2045.1 1423.0 2135.1 1408.7 C 2180.2 1402.1 2225.8 1398.8 2271.4 1398.6 C 2317.0 1398.9 2362.6 1402.9 2407.7 1409.4 C 2362.6 1402.6 2317.1 1398.4 2271.4 1397.8 C 2270.7 1397.8 2270.1 1397.8 2269.4 1397.8 C 2224.4 1397.8 2179.5 1400.8 2134.9 1407.1 "/></g></svg>`;

try{
  const renderer=new THREE.WebGLRenderer({antialias:true,alpha:true,powerPreference:'high-performance'});
  renderer.setPixelRatio(Math.min(devicePixelRatio,2));
  renderer.outputColorSpace=THREE.SRGBColorSpace;
  renderer.toneMapping=THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure=1.05;
  box.appendChild(renderer.domElement);

  const scene=new THREE.Scene();
  const pmrem=new THREE.PMREMGenerator(renderer);
  scene.environment=pmrem.fromScene(new RoomEnvironment(renderer),0.035).texture;

  const camera=new THREE.PerspectiveCamera(28,1,0.1,100);

  const luzA=new THREE.DirectionalLight(0xffe2c4,2.2);luzA.position.set(3,4,5);scene.add(luzA);
  const luzB=new THREE.DirectionalLight(0xff9f8a,1.1);luzB.position.set(-4,-2,3);scene.add(luzB);

  const data=new SVGLoader().parse(SVG);
  const geos=[];
  data.paths.forEach(p=>SVGLoader.createShapes(p).forEach(s=>{
    geos.push(new THREE.ExtrudeGeometry(s,{depth:70,bevelEnabled:true,bevelThickness:9,bevelSize:1.6,bevelSegments:5,curveSegments:40}));
  }));
  // limites comuns para centralizar e colorir
  const bb=new THREE.Box3();
  geos.forEach(g=>{g.computeBoundingBox();bb.union(g.boundingBox)});
  const c=bb.getCenter(new THREE.Vector3()),sz=bb.getSize(new THREE.Vector3());
  const escala=4/sz.y;
  const topo=new THREE.Color('#fff6c8'),meio=new THREE.Color('#f0b894'),base=new THREE.Color('#8e5645');
  const tmp=new THREE.Color();
  geos.forEach(g=>{
    g.translate(-c.x,-c.y,-c.z);g.scale(escala,escala,escala);
    const pos=g.attributes.position,cor=new Float32Array(pos.count*3);
    for(let i=0;i<pos.count;i++){
      const t=(pos.getY(i)/(sz.y*escala))+.5; // 0 embaixo, 1 em cima
      if(t>.5)tmp.copy(meio).lerp(topo,(t-.5)*2);else tmp.copy(base).lerp(meio,t*2);
      cor[i*3]=tmp.r;cor[i*3+1]=tmp.g;cor[i*3+2]=tmp.b;
    }
    g.setAttribute('color',new THREE.BufferAttribute(cor,3));
  });
  const frente=new THREE.MeshPhysicalMaterial({vertexColors:true,metalness:1,roughness:.26,clearcoat:.5,clearcoatRoughness:.18,envMapIntensity:1.25});
  const lado=new THREE.MeshPhysicalMaterial({vertexColors:true,metalness:1,roughness:.38,envMapIntensity:.9,color:0xd9a58a});
  const grupo=new THREE.Group();
  geos.forEach(g=>grupo.add(new THREE.Mesh(g,[frente,lado])));
  scene.add(grupo);

  function ajustar(){
    const w=box.clientWidth,h=box.clientHeight;if(!w||!h)return;
    renderer.setSize(w,h,false);
    camera.aspect=w/h;
    const alvoH=4.9,alvoW=(sz.x*escala)*1.35;
    const fov=THREE.MathUtils.degToRad(camera.fov);
    const dH=(alvoH/2)/Math.tan(fov/2);
    const dW=(alvoW/2)/Math.tan(fov/2)/camera.aspect;
    camera.position.set(0,0,Math.max(dH,dW));
    camera.updateProjectionMatrix();
  }
  new ResizeObserver(()=>{ajustar();if(reduz)render(0)}).observe(box);
  ajustar();

  let mx=0,my=0,tx=0,ty=0,rolagem=0;
  addEventListener('pointermove',e=>{tx=(e.clientX/innerWidth-.5);ty=(e.clientY/innerHeight-.5)},{passive:true});
  addEventListener('scroll',()=>{rolagem=Math.min(scrollY/innerHeight,1.2)},{passive:true});

  function render(t){
    const s=t/1000;
    mx+=(tx-mx)*.05;my+=(ty-my)*.05;
