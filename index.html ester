<style>
:root{
  color-scheme: light;
  --vinho:#933e41;       /* cor oficial da marca */
  --vinho-2:#7d3336;
  --vinho-3:#5c2427;
  --couro:#3f181b;
  --ouro-claro:#fffac0;
  --ouro-rose:#eeb08f;
  --bronze:#774637;
  --creme:#f8ebdf;
  --creme-2:#ecd0c0;
  --linha:rgba(238,176,143,.28);
  --linha-forte:rgba(238,176,143,.55);
  --ouro: linear-gradient(170deg,#fffac0 0%,#f3c9a2 45%,#e3a283 70%,#a8695a 100%);
  --serif:"Bodoni Moda", "Didot", "Bodoni 72", Georgia, serif;
  --sans:"Jost", "Futura", "Century Gothic", "Avenir Next", system-ui, sans-serif;
  --gutter:clamp(16px,5vw,64px);
  --max:1240px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--vinho);color:var(--creme);font-family:var(--sans);font-weight:300;font-size:17px;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit}
img,svg,canvas{max-width:100%}
:focus-visible{outline:1px solid var(--ouro-claro);outline-offset:4px}
.wrap{max-width:var(--max);margin:0 auto;padding-inline:var(--gutter)}
.gold{background:var(--ouro);-webkit-background-clip:text;background-clip:text;color:transparent}
.eyebrow{font-family:var(--sans);font-weight:400;font-size:12.5px;letter-spacing:.32em;text-transform:uppercase;color:var(--creme-2)}
h1,h2,h3{font-family:var(--serif);font-weight:400;text-wrap:balance;margin:0;letter-spacing:-.005em}
h2{font-size:clamp(34px,4.6vw,58px);line-height:1.08}
h3{font-size:clamp(22px,2vw,27px);line-height:1.2}
p{margin:0}
em{font-style:italic}

/* ---------- botões ---------- */
.btn{display:inline-flex;align-items:center;gap:12px;font-family:var(--sans);font-weight:400;font-size:13px;letter-spacing:.22em;text-transform:uppercase;text-decoration:none;padding:17px 28px;border-radius:0;transition:transform .35s cubic-bezier(.2,.7,.2,1),background .35s,color .35s,border-color .35s;cursor:pointer;border:0}
.btn-ouro{background:var(--ouro);color:var(--couro);box-shadow:0 14px 30px -14px rgba(40,10,10,.7)}
.btn-ouro:hover{transform:translateY(-2px)}
.btn-linha{border:1px solid var(--linha-forte);color:var(--creme);background:transparent}
.btn-linha:hover{border-color:var(--ouro-claro);color:var(--ouro-claro)}
.btn svg{width:18px;height:18px;flex:none}

/* ---------- topo ---------- */
.topo{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;transition:background .4s,border-color .4s,backdrop-filter .4s;border-bottom:1px solid transparent}
.topo.solido{background:rgba(122,49,52,.88);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom-color:var(--linha)}
.topo .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px;height:78px}
.marca{display:block;height:42px;flex:none}
.marca svg{height:100%;width:auto;display:block}
.nav{display:flex;align-items:center;gap:34px}
.nav a{font-size:12.5px;letter-spacing:.24em;text-transform:uppercase;text-decoration:none;color:var(--creme-2);font-weight:400;position:relative;padding-block:6px}
.nav a::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:1px;background:var(--ouro-rose);transition:right .4s}
.nav a:hover{color:var(--creme)}
.nav a:hover::after{right:0}
.nav a.btn{padding:12px 18px;font-size:11.5px;color:var(--couro)}
.nav a.btn:hover{color:var(--couro)}
.nav .btn::after{display:none}
.nav a[aria-current="page"]{color:var(--creme)}
.nav a[aria-current="page"]::after{right:0}
.menu-btn{display:none;position:relative;width:46px;height:46px;background:transparent;border:1px solid var(--linha-forte);cursor:pointer;flex:none}
.menu-btn span{position:absolute;left:13px;right:13px;height:1px;background:var(--ouro-claro);transition:transform .35s,top .35s}
.menu-btn span:nth-child(1){top:18px}.menu-btn span:nth-child(2){top:27px}
.menu-btn[aria-expanded="true"] span:nth-child(1){top:22px;transform:rotate(45deg)}
.menu-btn[aria-expanded="true"] span:nth-child(2){top:22px;transform:rotate(-45deg)}
.sr{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
@media (max-width:1040px){
  .menu-btn{display:block}
  .topo .wrap{position:relative}
  .nav{position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;background:var(--vinho-3);border-bottom:1px solid var(--linha-forte);padding:8px var(--gutter) 24px;box-shadow:0 30px 40px -20px rgba(20,4,6,.6);visibility:hidden;opacity:0;transform:translateY(-8px);transition:opacity .3s,transform .3s,visibility .3s}
  .nav.aberta{visibility:visible;opacity:1;transform:none}
  .nav a:not(.btn){padding-block:16px;border-bottom:1px solid var(--linha);font-size:13px}
  .nav a:not(.btn)::after{display:none}
  .nav a.btn{margin-top:18px;justify-content:center;padding:15px 18px}
}
@media (max-width:520px){.marca{height:34px}}

/* ---------- hero ---------- */
.hero{position:relative;overflow:hidden;margin-top:-78px;padding-top:78px}
.hero::before{content:"";position:absolute;inset:0;background:
  radial-gradient(60% 70% at 72% 45%,rgba(255,220,190,.16),transparent 60%),
  radial-gradient(90% 60% at 10% 110%,rgba(40,10,12,.45),transparent 60%);pointer-events:none}
.hero .wrap{position:relative;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:32px;padding-block:clamp(40px,7vw,96px) clamp(48px,6vw,80px)}
.hero-txt{display:flex;flex-direction:column;gap:28px;max-width:620px}
.hero h1{font-size:clamp(34px,4.2vw,58px);line-height:1.06;letter-spacing:-.015em}
.hero h1 em{font-style:italic}
.hero .lead{font-size:clamp(17px,1.4vw,19px);color:var(--creme-2);max-width:34em}
.acoes{display:flex;flex-wrap:wrap;gap:14px}
.oab{display:flex;flex-wrap:wrap;align-items:center;gap:14px;font-size:12.5px;letter-spacing:.28em;text-transform:uppercase;color:var(--creme-2)}
.oab::before{content:"";width:44px;height:1px;background:var(--ouro-rose)}

.palco{position:relative;aspect-ratio:1/1.08;width:100%;max-width:560px;justify-self:center}
.palco .aro{position:absolute;inset:6% 4%;border:1px solid var(--linha);border-radius:50%;transform:rotateX(68deg) translateZ(-40px);transform-style:preserve-3d}
.palco .sombra{position:absolute;left:22%;right:22%;bottom:3%;height:9%;background:radial-gradient(closest-side,rgba(30,6,8,.55),transparent);filter:blur(6px)}
#mono3d{position:absolute;inset:0}
#mono3d canvas{position:absolute;inset:0;width:100%!important;height:100%!important;opacity:0;transition:opacity 1.2s ease}
#mono3d.pronto canvas{opacity:1}
#mono3d .fallback{position:absolute;inset:12% 20%;transition:opacity .8s ease}
#mono3d .fallback svg{width:100%;height:100%;filter:drop-shadow(0 18px 24px rgba(40,8,10,.5))}
#mono3d.pronto .fallback{opacity:0}
.palco .dica{position:absolute;right:0;bottom:0;font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--creme-2);opacity:.7}

@media (max-width:900px){
  .hero .wrap{grid-template-columns:1fr;gap:8px}
  .palco{order:-1;max-width:340px;aspect-ratio:1/1}
  .palco .dica{display:none}
}

/* faixa de áreas */
.faixa{border-block:1px solid var(--linha);background:var(--vinho-2);overflow:hidden}
.faixa .trilho{display:flex;gap:48px;white-space:nowrap;padding-block:18px;animation:correr 48s linear infinite;width:max-content}
.faixa span{font-family:var(--serif);font-style:italic;font-size:21px;color:var(--creme-2);display:inline-flex;align-items:center;gap:48px}
.faixa span::after{content:"";width:7px;height:7px;border:1px solid var(--ouro-rose);transform:rotate(45deg)}
@keyframes correr{to{transform:translateX(-50%)}}

/* ---------- seções ---------- */
section{position:relative}
.sec{padding-block:clamp(72px,10vw,140px)}
.cab{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px 64px;align-items:end;margin-bottom:clamp(40px,6vw,72px)}
.cab .eyebrow{grid-column:1/-1}
.cab h2.longo{font-size:clamp(30px,3.6vw,48px);line-height:1.12}
.cab p{color:var(--creme-2);max-width:32em}
@media (max-width:820px){.cab{grid-template-columns:1fr}}

/* áreas */
.areas{background:var(--vinho)}
.frente{border-top:1px solid var(--linha-forte);padding-top:34px}
.frente-cab{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:10px 24px;margin-bottom:28px}
.frente-cab .rotulo{font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--ouro-rose)}
.lista{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:56px}
.lista li{display:grid;grid-template-columns:22px 1fr;gap:4px 14px;padding-block:20px;border-bottom:1px solid var(--linha)}
.lista li::before{content:"";width:8px;height:8px;border:1px solid var(--ouro-rose);transform:rotate(45deg);margin-top:11px;grid-row:span 2}
.lista b{font-weight:400;font-family:var(--serif);font-size:20px;line-height:1.3;color:var(--creme)}
.lista small{font-size:15px;color:var(--creme-2);line-height:1.55}
.frentes-duplas{display:grid;grid-template-columns:1.25fr 1fr;align-items:start;gap:28px;margin-top:72px;perspective:1400px}
.painel{position:relative;padding:clamp(28px,3.4vw,44px);background:linear-gradient(160deg,rgba(255,240,220,.07),rgba(40,10,12,.12));border:1px solid var(--linha);transform-style:preserve-3d;transition:transform .5s cubic-bezier(.2,.7,.2,1),border-color .4s;will-change:transform}
.painel:hover{border-color:var(--linha-forte)}
.painel .frente-cab{margin-bottom:12px}
.painel .lista{grid-template-columns:1fr}
.painel .lista li:last-child{border-bottom:0}
.painel .marca-agua{position:absolute;right:-6px;bottom:-10px;width:110px;opacity:.1;transform:translateZ(30px);pointer-events:none}
@media (max-width:820px){.lista{grid-template-columns:1fr}.frentes-duplas{grid-template-columns:1fr}}

/* calculadora de prazo */
.prazo{background:var(--couro);overflow:hidden}
