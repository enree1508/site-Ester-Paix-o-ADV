<script>
/* navegação por páginas */
(function(){
  var nomes=['inicio','atuacao','advogada','duvidas','contato'];
  var pags=[].slice.call(document.querySelectorAll('.pagina'));
  var contato=document.getElementById('sec-contato');
  var nav=document.getElementById('nav'),mb=document.getElementById('menu-btn'),barra=document.getElementById('troca');
  var atual=null;
  function anima(el){el.classList.remove('anim');void el.offsetWidth;el.classList.add('anim')}
  function fecharMenu(){nav.classList.remove('aberta');mb.setAttribute('aria-expanded','false')}
  function mostrar(n,animar){
    if(nomes.indexOf(n)<0)n='inicio';
    if(n===atual){fecharMenu();try{window.scrollTo({top:0,behavior:'smooth'})}catch(e){window.scrollTo(0,0)}return}
    atual=n;
    pags.forEach(function(p){var on=p.getAttribute('data-pagina')===n;p.hidden=!on;if(on&&animar)anima(p)});
    if(n==='contato'&&animar)anima(contato);
    document.body.setAttribute('data-pag',n);
    nav.querySelectorAll('[data-ir]').forEach(function(a){if(a.getAttribute('data-ir')===n)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current')});
    try{window.scrollTo({top:0,left:0,behavior:'instant'})}catch(e){window.scrollTo(0,0)}
    if(animar){barra.classList.remove('vai');void barra.offsetWidth;barra.classList.add('vai')}
    fecharMenu();
  }
  document.addEventListener('click',function(e){
    var a=e.target.closest('[data-ir]');if(!a)return;
    e.preventDefault();
    var n=a.getAttribute('data-ir');
    mostrar(n,true);
    try{if(location.hash.slice(1)!==n)location.hash=n}catch(err){}
  });
  window.addEventListener('hashchange',function(){mostrar(location.hash.slice(1),true)});
  mb.addEventListener('click',function(){var ab=nav.classList.toggle('aberta');mb.setAttribute('aria-expanded',ab?'true':'false')});
  var h='';try{h=location.hash.slice(1)}catch(e){}
  mostrar(h||'inicio',false);
})();

/* topo sólido ao rolar */
(function(){
